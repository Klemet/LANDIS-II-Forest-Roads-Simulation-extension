<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <NeutralLanguage>English</NeutralLanguage>
    <RootNamespace>Landis.Extension.ForestRoadsSimulation</RootNamespace>
    <AssemblyName>Landis.Extension.ForestRoadsSimulation</AssemblyName>
    <AssemblyTitle>Landis.Extension.ForestRoadsSimulation</AssemblyTitle>
    <PackageLicenseUrl>https://github.com/Klemet/LANDIS-II-Forest-Roads-Simulation-module/blob/master/LICENSE.md</PackageLicenseUrl>
    <PackageProjectUrl>http://www.landis-ii.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Klemet/LANDIS-II-Forest-Roads-Simulation-module</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>LANDIS-II;Landis;Extension;Forest roads</PackageTags>
    <Authors>Clement Hardy</Authors>
    <Description>Forest Roads Simulation Module</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet packages (auto-restored by dotnet). Landis.Core brings
         Landis.SpatialModeling and Landis.Utilities transitively; the code also
         uses Landis.Landscapes directly, so it is referenced explicitly. -->
    <PackageReference Include="Landis.Core" Version="3.0.1" />
    <PackageReference Include="Landis.Landscapes" Version="2.0.1" />
    <PackageReference Include="C5" Version="2.5.3" />
    <PackageReference Include="log4net" Version="2.0.14" />
    <PackageReference Include="OptimizedPriorityQueue" Version="4.2.0" />
    <PackageReference Include="Supercluster.KDTree" Version="1.0.4" />
    <PackageReference Include="Troschuetz.Random" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- LANDIS-II provides these libraries at run time: compile against them, but
         never copy them into the output folder (which is shared with every other
         extension in the Docker builds), so a build can never overwrite a newer
         installed copy. See issue #4. -->
    <!-- Local LANDIS-II extension DLLs in src/lib/ (fetch via support_libs_download.ps1;
         HintPaths rewritten by the Docker build scripts to build/extensions) -->
    <Reference Include="Landis.Library.UniversalCohorts-v2">
      <HintPath>lib\Landis.Library.UniversalCohorts-v2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Landis.Library.HarvestManagement-v5">
      <HintPath>lib\Landis.Library.HarvestManagement-v5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Landis.Library.Metadata-v2">
      <HintPath>lib\Landis.Library.Metadata-v2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- SDK-style projects turn every file under src/ into a None item, and MSBuild
         resolves references from those items ({CandidateAssemblyFiles}) BEFORE the
         HintPath. Committed (or freshly downloaded) lib/*.dll and packages/*.dll would
         therefore shadow the HintPath: compiling against a stale copy and copying it
         over the installed libraries. Keep them out of the project items; only the
         HintPath decides. -->
    <None Remove="lib\**" />
    <None Remove="packages\**" />
  </ItemGroup>
</Project>
